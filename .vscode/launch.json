{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Suma",
            "request": "launch",
            "mainClass": "Suma",
            "projectName": "classtests_64cc24a"
        },
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": [
                9003,
                9000
            ],
            "pathMappings": {
                "${workspaceFolder}": "${workspaceFolder}"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Depurar JS con Node",
            "program": "${file}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Abrir HTML actual en Chrome",
            "file": "${file}"
        },
        {
            "name": "Launch Current File on Localhost",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost/classtests/${relativeFile}",
            "webRoot": "${workspaceFolder}"
        }
    ]
}